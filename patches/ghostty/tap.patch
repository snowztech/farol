@@ -682,6 +692,19 @@ pub fn processOutput(self: *Termio, buf: []const u8) void {
 
 /// Process output from readdata but the lock is already held.
 fn processOutputLocked(self: *Termio, buf: []const u8) void {
+    if (self.farol_tap) |*tap| farol: {
+        if (self.farol_tap_overflow) break :farol;
+        // A megabyte nobody read means the host stopped reading, and starts over.
+        if (tap.items.len + buf.len > 1024 * 1024) {
+            self.farol_tap_overflow = true;
+            tap.clearRetainingCapacity();
+            break :farol;
+        }
+        tap.appendSlice(self.alloc, buf) catch {
+            self.farol_tap_overflow = true;
+        };
+    }
+
     // Schedule a render. We can call this first because we have the lock.
