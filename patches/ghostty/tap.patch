+    /// Farol: opens the pane's tap, or starts it over: the screen as
+    /// ghostty_surface_read_vt_screen gives it and up to `history_rows` rows
+    /// above it, read under the lock that empties the tap. What
+    /// ghostty_surface_tap_read gives next is what the program wrote after
+    /// that screen, so the two make one stream with no gap.
+    export fn ghostty_surface_tap_start(
+        surface: *Surface,
+        history_rows: u32,
+        history: *Text,
+        screen: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        history.* = .{ .tl_px_x = -1, .tl_px_y = -1, .offset_start = 0, .offset_len = 0, .text = null, .text_len = 0 };
+        if (history_rows > 0) _ = readVtLocked(surface, history_rows, history) catch false;
+        const read = readVtLocked(surface, null, screen) catch |err| {
+            log.warn("error reading vt for the tap err={}", .{err});
+            history.deinit();
+            return false;
+        };
+        if (!read) {
+            history.deinit();
+            return false;
+        }
+
+        const io = &core_surface.io;
+        if (io.farol_tap) |*tap| tap.clearRetainingCapacity() else io.farol_tap = .empty;
+        io.farol_tap_overflow = false;
+        return true;
+    }
+
+    /// Farol: what the program wrote since the tap started or was last
+    /// read. 1 with bytes in `result`, 0 when nothing came, and -1 when the
+    /// tap is closed or went over its limit, so it needs starting again.
+    export fn ghostty_surface_tap_read(surface: *Surface, result: *Text) i32 {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        const io = &core_surface.io;
+        const tap = if (io.farol_tap) |*tap| tap else return -1;
+        if (io.farol_tap_overflow) return -1;
+        if (tap.items.len == 0) return 0;
+        const text = global.alloc().dupeZ(u8, tap.items) catch return -1;
+        tap.clearRetainingCapacity();
+        result.* = .{ .tl_px_x = -1, .tl_px_y = -1, .offset_start = 0, .offset_len = 0, .text = text.ptr, .text_len = text.len };
+        return 1;
+    }
+
+    /// Farol: closes the tap, so the program's output is kept no more.
+    export fn ghostty_surface_tap_stop(surface: *Surface) void {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        const io = &core_surface.io;
+        if (io.farol_tap) |*tap| tap.deinit(io.alloc);
+        io.farol_tap = null;
+        io.farol_tap_overflow = false;
+    }
+
     fn readVt(surface: *Surface, history: ?u32, result: *Text) !bool {
         const core_surface = &surface.core_surface;
         core_surface.renderer_state.mutex.lockUncancelable(global.io());
         defer core_surface.renderer_state.mutex.unlock(global.io());
+        return readVtLocked(surface, history, result);
+    }
 
